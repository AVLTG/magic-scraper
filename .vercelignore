# Never upload local-only / secret files to a Vercel build context.
# (Vercel injects env vars from the dashboard; these are not needed.)
.env*
dev.db
dev.db-shm
dev.db-wal
# Root-anchored (leading slash) so these match ONLY the Turso CLI artifacts at
# the repo root — a bare "auth" would also match src/app/api/auth/ and drop the
# login/logout routes from the build.
/auth
/auth-wal
src/lib/seedUsers.ts

# Local tooling / artifacts not needed for the build.
node_modules
.next
.git
.vercel
.planning
.claude
